rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    function participates() {
      return signedIn()
        && request.auth.uid in resource.data.participantUIDs;
    }

    function willParticipate() {
      return signedIn()
        && request.auth.uid in request.resource.data.participantUIDs;
    }

    match /users/{userId} {
      allow read, write: if isUser(userId);

      match /people/{personId} {
        allow read, write: if isUser(userId);
      }
    }

    match /bills/{billId} {
      allow read: if participates();
      allow create: if willParticipate();
      allow update, delete: if participates() && willParticipate();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
